# Web3Forms — RSVP notifications (recipient is the email verified when you created the access key)
WEB3FORMS_ACCESS_KEY=c35b1299-513f-4b9b-90f1-3a579365f603

# Optional: used only for local dev logging; Web3Forms sends to the email tied to the access key above
