# Optional: Upstash Redis for production (keeps RSVPs when deployed to Vercel)
# Without this, RSVPs are saved to data/rsvps.json (works locally / on a VPS)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
