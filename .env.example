# Gmail account used to send RSVP digest emails
GMAIL_USER=abenidemiss300@gmail.com

# Gmail App Password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_APP_PASSWORD=your-16-character-app-password

# Where RSVP digest emails are delivered (defaults to abenidemiss300@gmail.com)
RSVP_NOTIFY_EMAIL=abenidemiss300@gmail.com

# Optional: Upstash Redis for production (keeps RSVPs when deployed to Vercel)
# Without this, RSVPs are saved to data/rsvps.json (works locally / on a VPS)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
